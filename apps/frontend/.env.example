# Copy this file to .env.local (never commit .env.local) and restart `npm run dev`.
# NEXT_PUBLIC_ values are inlined into the browser bundle at build time and are
# visible to every visitor. Never put an AWS key, token or other secret here.

# "mock" (default when unset): built-in sample data, no backend needed.
# "api": use the real backend. A failed request is shown as an error and never
#        falls back to sample data.
NEXT_PUBLIC_SITE_REVIVE_API_MODE=mock

# Origin of the backend API. Required when the mode is "api".
#   sam local (npm run dev:backend from the repo root): http://localhost:3001
#   deployed: the SiteRevive API Gateway URL (must be https:// in production)
NEXT_PUBLIC_SITE_REVIVE_API_URL=http://localhost:3001

# Optional. Origin that serves the capture screenshots (the capture worker).
# Only needed if the backend returns screenshot paths ("/artifacts/...") instead
# of full URLs, i.e. when CAPTURE_WORKER_PUBLIC_URL is not set on the backend.
# NEXT_PUBLIC_SITE_REVIVE_SCREENSHOT_BASE_URL=http://localhost:3002
