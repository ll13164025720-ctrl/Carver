{
  "name": "siterevive",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "apps/capture-worker"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:capture": "npm run dev --workspace=@siterevive/capture-worker"
  }
}
